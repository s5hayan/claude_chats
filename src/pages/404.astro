---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not on the menu" showBook={false}>
  <div class="container-page page">
    <p class="label">404</p>
    <h1>That's not on the menu.</h1>
    <p>The page you ordered doesn't exist, or it's been taken off.</p>
    <a class="btn btn-hot" href="/">Back to The Menu</a>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    max-width: 12ch;
  }
</style>
