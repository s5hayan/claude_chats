---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gif from '../components/Gif.astro';
---

<BaseLayout title="Not on the menu" showBook={false}>
  <div class="page">
    <p class="label">404</p>
    <h1>That's not on the menu.</h1>
    <p>Whatever you ordered doesn't exist, or the kitchen has taken it off for the season.</p>
    <Gif
      src="https://media.tenor.com/0FyLC3FdRL8AAAAM/scared-courage.gif"
      alt="Courage the Cowardly Dog cowering in fright on an armchair"
      caption="The things I do for this website."
      tilt={-3}
    />
    <a class="btn btn-hot" href="/">Back to the menu</a>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
    text-align: center;
    padding-block: clamp(2rem, 8vw, 5rem);
  }
  h1 {
    font-size: clamp(2.4rem, 8vw, 4.2rem);
    max-width: 14ch;
  }
</style>
