---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MenuHeader from '../../components/MenuHeader.astro';
import Todo from '../../components/Todo.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Mains" description="The stories behind a few things Mohamed Shayan has made at Segwise.ai: the ingredients, the method, what was served and one lesson.">
  <MenuHeader course="The mains" title="The longer stories" level="h1" />
  <p class="intro">
    Each one is plated the same way: what was in the fridge, how it got cooked, what ended up on the table and the
    one thing I'd tell myself next time.
  </p>
  <ul class="items">
    {work.map((entry) => (
      <li class="item">
        <a href={`/work/${entry.id}/`} class="leader-row">
          <span class="i-name">{entry.data.title}</span>
          <span class="dots" aria-hidden="true"></span>
          <span class="i-tag">{entry.data.label}</span>
        </a>
        <p class="i-desc"><Todo text={entry.data.summary} /></p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    max-width: 52ch;
    margin: 1.5rem auto 2.5rem;
    text-align: center;
    font-size: 1.08rem;
  }
  .items {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    gap: 0.35rem;
  }
  .item a {
    text-decoration: none;
  }
  .i-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    min-width: 0;
  }
  .item a:hover .i-name {
    color: var(--accent);
  }
  .i-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .i-desc {
    max-width: 60ch;
    color: var(--fg-muted);
  }
</style>
