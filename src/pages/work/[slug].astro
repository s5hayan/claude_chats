---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Todo from '../../components/Todo.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, label, number, numberCaption, summary } = entry.data;
---

<BaseLayout title={title} description={summary.includes('TODO') ? undefined : summary}>
  <article class="dish">
    <a href="/work/" class="back label">← All mains</a>
    <header class="dish-head">
      <p class="label kind">{label}</p>
      <h1>{title}</h1>
      <p class="summary"><Todo text={summary} /></p>
      <p class="plate leader-row">
        <span class="cap"><Todo text={numberCaption} /></span>
        <span class="dots" aria-hidden="true"></span>
        <span class="num"><Todo text={number} /></span>
      </p>
    </header>
    <div class="prose-menu body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .dish {
    display: grid;
    gap: 2rem;
  }
  .back {
    text-decoration: none;
    width: fit-content;
  }
  .back:hover {
    color: var(--accent);
  }
  .dish-head {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 3px double var(--rule);
  }
  .kind {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2.3rem, 7vw, 3.8rem);
    max-width: 18ch;
  }
  .summary {
    max-width: 50ch;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.5;
  }
  .plate {
    width: min(100%, 30rem);
    text-align: left;
  }
  .cap {
    font-family: var(--font-serif);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--accent);
  }
  .body {
    margin-inline: auto;
  }
  .body :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }
  .body :global(h2)::before {
    content: '✦';
    font-size: 0.45em;
    color: var(--accent);
    transform: translateY(-0.3em);
  }
</style>
