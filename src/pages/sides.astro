---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuHeader from '../components/MenuHeader.astro';
import Todo from '../components/Todo.astro';

const sides = (await getCollection('sides')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Side Dishes" description="Food walks, pop-ups, the See Hear Taste newsletter, volunteering and side builds by Mohamed Shayan.">
  <MenuHeader course="Side dishes" title="Off the main menu" level="h1" />
  <p class="intro">Food, teaching, community and the things I build when nobody's asked me to.</p>
  <ul class="items">
    {sides.map(({ data }) => (
      <li class="item">
        <div class="leader-row">
          <h2 class="i-name">{data.link ? <a href={data.link}>{data.title} ↗</a> : data.title}</h2>
          <span class="dots" aria-hidden="true"></span>
          <span class="i-tag">{data.kind}</span>
        </div>
        <p class="i-desc"><Todo text={data.blurb} /></p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    max-width: 50ch;
    margin: 1.5rem auto 2.5rem;
    text-align: center;
    font-size: 1.08rem;
  }
  .items {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    gap: 0.35rem;
  }
  .i-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    min-width: 0;
  }
  .i-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .i-desc {
    max-width: 60ch;
    color: var(--fg-muted);
  }
</style>
