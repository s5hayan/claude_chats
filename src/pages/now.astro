---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuHeader from '../components/MenuHeader.astro';

const entry = await getEntry('now', 'index');
if (!entry) throw new Error('Missing src/content/now/index.md');
const { Content } = await render(entry);
const updated = entry.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Today's Specials" description="What Mohamed Shayan is working on, eating, watching and following this month.">
  <div class="container-page page">
    <MenuHeader course="Today's Specials" title="On the board this month" level="h1" />
    <p class="board label">Updated {updated} · {entry.data.location}</p>
    <div class="prose-menu specials">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .board {
    width: fit-content;
    background: var(--inverse-bg);
    color: var(--yolk);
    padding: 0.4em 0.8em;
  }
  .specials :global(h2) {
    background: var(--yolk);
    color: var(--on-accent);
    border: var(--line-thin) solid var(--edge);
    width: fit-content;
    padding: 0.1em 0.3em;
    font-size: clamp(1.5rem, 4vw, 2rem);
  }
</style>
