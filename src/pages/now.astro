---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuHeader from '../components/MenuHeader.astro';
import Jukebox from '../components/Jukebox.astro';

const entry = await getEntry('now', 'index');
if (!entry) throw new Error('Missing src/content/now/index.md');
const { Content } = await render(entry);
const updated = entry.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Today's Specials" description="What Mohamed Shayan is working on, eating, watching and following this month.">
  <MenuHeader course="Today's specials" title="On the board this month" level="h1" />
  <p class="board label">Chalked up {updated} · {entry.data.location}</p>
  <div class="prose-menu specials">
    <Content />
  </div>
  <Jukebox />
</BaseLayout>

<style>
  .board {
    margin: 1.2rem 0 2rem;
    text-align: center;
  }
  .specials {
    margin-inline: auto;
  }
  .specials :global(h2) {
    font-size: 1.5rem;
  }
  .specials :global(h2:first-child) {
    margin-top: 0;
  }
</style>
