---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="season">This menu changes with the seasons. You're reading the first one.</p>
  <p class="built">
    © {year} {site.name} · {site.location} · Built by directing{' '}
    <a href="https://claude.com/claude-code">Claude Code</a>
  </p>
</footer>

<style>
  .site-footer {
    width: min(100% - 2 * var(--gutter), var(--card-max));
    margin-inline: auto;
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    text-align: center;
    padding-block: 2rem 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .season {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--fg);
  }
</style>
