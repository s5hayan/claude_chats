---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-page inner">
    <p class="sign">{site.name}</p>
    <ul>
      {site.nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href={site.contact.github} rel="me">GitHub</a></li>
    </ul>
    <p class="built">
      © {year} · {site.location} · Built by directing{' '}
      <a href="https://claude.com/claude-code">Claude Code</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
  }
  .inner {
    display: grid;
    gap: 1rem;
    padding-block: 2.5rem;
  }
  .sign {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  a {
    text-decoration-color: var(--yolk);
    text-underline-offset: 3px;
  }
  .built {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--paper-deep);
  }
</style>
