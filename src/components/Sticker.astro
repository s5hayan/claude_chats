---
// Decorative SVG badge from /public/stickers. Hidden from assistive tech.
interface Props {
  name: 'shipped' | 'chilli' | 'cricket-ball' | 'passport' | 'star';
  size?: number;
  rotate?: number;
  class?: string;
}
const { name, size = 96, rotate = -8, class: className } = Astro.props;
---

<img
  src={`/stickers/${name}.svg`}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
  class:list={['sticker', className]}
  style={`--r: ${rotate}deg`}
/>

<style>
  .sticker {
    display: block;
    pointer-events: auto;
    transform: rotate(var(--r));
    filter: drop-shadow(3px 3px 0 var(--shadow-colour));
    transition: transform 0.2s ease;
    user-select: none;
  }
  .sticker:hover {
    animation: wiggle 0.5s ease-in-out;
  }
  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(var(--r));
    }
    25% {
      transform: rotate(calc(var(--r) - 8deg)) scale(1.05);
    }
    75% {
      transform: rotate(calc(var(--r) + 8deg)) scale(1.05);
    }
  }
</style>
