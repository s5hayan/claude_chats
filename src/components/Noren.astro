---
// The split curtain that hangs in a ramen bar doorway, as a fixed rail on the left.
// Ramen variant only. Decorative.
import { site } from '../config/site';
---

<div class="noren" aria-hidden="true">
  <span class="kana">シャヤン</span>
  <span class="name">{site.shortName.toUpperCase()}</span>
  <span class="mark">麺</span>
</div>

<style>
  .noren {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 20;
    width: calc(var(--rail) + env(safe-area-inset-left, 0px));
    padding-left: env(safe-area-inset-left, 0px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-block: calc(env(safe-area-inset-top, 0px) + 1.5rem) 1.5rem;
    background:
      linear-gradient(to bottom, transparent 0 34%, var(--bg) 34% calc(34% + 3px), transparent 0)
        no-repeat,
      linear-gradient(to bottom, transparent 0 67%, var(--bg) 67% calc(67% + 3px), transparent 0)
        no-repeat,
      var(--tomato);
    color: var(--on-accent);
    font-family: var(--font-display);
    box-shadow: var(--glow);
  }
  .kana,
  .name {
    writing-mode: vertical-rl;
  }
  .kana {
    font-size: 1.5rem;
    letter-spacing: 0.15em;
  }
  .name {
    font-size: 1.1rem;
    letter-spacing: 0.3em;
  }
  .mark {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--on-accent);
    border-radius: 50%;
    font-size: 1.1rem;
  }
  @media (max-width: 860px) {
    .noren {
      display: none;
    }
  }
</style>
