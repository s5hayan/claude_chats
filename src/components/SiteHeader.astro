---
import { site } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="bar">
    <a href="/" class="logo">{site.shortName}</a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li><a href="#book" class="book">Book a Table</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    width: min(100% - 2 * var(--gutter), var(--card-max));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.4rem 1.2rem;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  nav a {
    text-decoration: none;
    padding-block: 0.2em;
    border-bottom: 1px solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--accent);
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .book {
    color: var(--accent);
  }
</style>
