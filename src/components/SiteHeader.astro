---
import { site } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container-page bar">
    <a href="/" class="logo">{site.shortName}<span aria-hidden="true">.</span></a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="#book" class="btn btn-hot book">Book a Table</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--line) solid var(--edge);
    background: var(--bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 0.9rem;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    margin-right: auto;
  }
  .logo span {
    color: var(--tomato);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  nav a {
    text-decoration: none;
    padding-block: 0.2em;
    border-bottom: var(--line) solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--yolk);
  }
  nav a[aria-current='page'] {
    border-bottom-color: var(--tomato);
  }
  .book {
    font-size: 0.9rem;
  }
  @media (max-width: 720px) {
    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
    }
    ul {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }
</style>
