---
import { getCollection } from 'astro:content';

const items = await getCollection('ticker');
// The list is rendered twice so the loop is seamless; the copy is hidden from assistive tech.
---

<div class="ticker" role="region" aria-label="What I'm into right now">
  <div class="track">
    {[0, 1].map((copy) => (
      <ul aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map(({ data }) => (
          <li>
            <span class="verb">{data.verb}</span>
            <span>{data.text}</span>
            <span class="star" aria-hidden="true">★</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .ticker {
    background: var(--ink);
    color: var(--paper);
    border-bottom: var(--line) solid var(--ink);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .track {
    display: flex;
    width: max-content;
    animation: roll 40s linear infinite;
  }
  .ticker:hover .track,
  .ticker:focus-within .track {
    animation-play-state: paused;
  }
  ul {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0.55rem 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 0.6em;
    align-items: center;
    padding-right: 2.2em;
    white-space: nowrap;
  }
  .verb {
    color: var(--yolk);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .star {
    color: var(--tomato);
    margin-left: 1.6em;
  }
  @keyframes roll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      width: auto;
      overflow-x: auto;
    }
    ul[aria-hidden='true'] {
      display: none;
    }
  }
</style>
