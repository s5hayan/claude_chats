---
import { site } from '../config/site';

const { email, linkedin, github } = site.contact;
---

<section id="book" class="book" aria-labelledby="book-title">
  <p class="label">Reservations</p>
  <h2 id="book-title">Book a Table</h2>
  <p class="lede">
    If you'd like to swap notes on product or customer success, build something with AI agents, or come along on a
    food walk, pull up a chair. I read everything that lands in my inbox.
  </p>
  <ul class="links">
    <li><a class="btn btn-hot" href={`mailto:${email}`}>{email}</a></li>
    <li><a class="btn" href={linkedin} rel="me">LinkedIn ↗</a></li>
    <li><a class="btn" href={github} rel="me">GitHub ↗</a></li>
  </ul>
</section>

<style>
  .book {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    text-align: center;
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: clamp(2rem, 6vw, 3rem);
    border-top: 3px double var(--rule);
    scroll-margin-top: 1rem;
  }
  h2 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
  }
  .lede {
    max-width: 46ch;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    text-transform: none;
    letter-spacing: 0.02em;
  }
</style>
