---
// Proof card: role-combo label, claim, big number, short context.
import Todo from './Todo.astro';

interface Props {
  label: string;
  claim: string;
  number: string;
  context: string;
  colour?: 'card' | 'yolk' | 'teal' | 'tomato';
  href?: string;
  tilt?: number;
}
const { label, claim, number, context, colour = 'card', href, tilt = 0 } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag href={href} class:list={['dish', `c-${colour}`]} style={`--tilt: ${tilt}deg`}>
  <p class="label">{label}</p>
  <p class="num"><Todo text={number} /></p>
  <h3 class="claim">{claim}</h3>
  <p class="context"><Todo text={context} /></p>
</Tag>

<style>
  .dish {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    background: var(--surface);
    border: var(--line) solid var(--edge);
    box-shadow: var(--shadow);
    padding: 1.1rem 1.1rem 1.25rem;
    text-decoration: none;
    color: var(--on-surface);
    transform: rotate(var(--tilt));
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .dish:hover {
    transform: translate(-3px, -3px) rotate(calc(var(--tilt) - 1deg));
    box-shadow: var(--shadow-lift);
  }
  .c-yolk,
  .c-teal,
  .c-tomato {
    color: var(--on-accent);
  }
  .c-yolk {
    background: var(--yolk);
  }
  .c-teal {
    background: var(--teal);
  }
  .c-tomato {
    background: var(--tomato);
  }
  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 4.25rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .claim {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: 0;
  }
  .context {
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>
